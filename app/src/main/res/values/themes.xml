<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AppTheme">
        <attr name="backgroundColor" format="color"/>
        <attr name="surfaceColor" format="color"/>
        <attr name="navColor" format="color"/>
        <attr name="textPrimaryColor" format="color"/>
        <attr name="textSecondaryColor" format="color"/>
        <attr name="dividerColor" format="color"/>
    </declare-styleable>

    <style name="Theme.TransitWallet" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/surface_nav_light</item>
        <item name="backgroundColor">@color/background_light</item>
        <item name="surfaceColor">@color/surface_light</item>
        <item name="navColor">@color/surface_nav_light</item>
        <item name="textPrimaryColor">@color/text_primary_light</item>
        <item name="textSecondaryColor">@color/text_secondary_light</item>
        <item name="dividerColor">@color/divider_light</item>
    </style>
</resources>
